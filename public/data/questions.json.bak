    "INFJ": {
      "mbti_type": "INFJ",
      "description": "INFJ是理想主义者，具有深刻的洞察力和强烈的同理心。他们追求意义和价值，倾向于帮助他人并寻找人生的目标。INFJ通常内向、直觉、情感丰富且富有创造力。",
      "heroes": {
        "hero_a": {
          "name": "大乔",
          "trait": "治愈、奉献、宿命感",
          "description": "代表了INFJ最温柔、奉献、精神指引的一面。她像一位悲天悯人的圣女，不仅守护队友，更在意灵魂的归宿。她的爱是无声且深沉的，是‘回家的灯塔’。",
          "enriched_description": "你就像个自带治愈光环的暖心大姐姐，总能在大家最崩溃的时候递上一杯心灵鸡汤。你坚信每个人都能找到属于自己的归途，连队友走错路都忍不住轻声劝导：“别怕，我在这儿呢。”“回家的灯塔，是我一生的信仰。”你用行动诠释了什么叫“别人家的姐姐”。"
        },
        "hero_b": {
          "name": "王昭君",
          "trait": "高冷、孤独、外冷内热",
          "description": "代表了INFJ外冷内热、孤独、理想主义的一面。她外表冰冷拒人千里，内心却藏着对故乡或某人的深情。她用寒冷来保护自己柔软的内心，是‘雪中的红梅’。",
          "enriched_description": "你就像冬天里的一朵红梅，表面冷得像块冰，其实心里藏着一整个春天的温柔。别人以为你高冷拒人，其实你只是怕被伤害，毕竟谁不想做个暖男呢？“我来保护你”——听起来像是霸道总裁，其实是你对世界最后的倔强。"
        },
        "hero_c": {
          "name": "达摩",
          "trait": "哲学、苦行、求真",
          "description": "代表了INFJ哲学、探索、自我磨砺的一面。他不像大乔那样守护他人，也不像王昭君那样守望故土，他一直在寻找‘真理’和‘自我’。他通过肉体的苦行来追求精神的升华，是‘行走的哲学家’。",
          "enriched_description": "你这人啊，典型的“行走的哲学书”，天天在脑子里打坐修心，连吃饭都要思考人生。别人在朋友圈晒美食，你却发“今天吃的是真理的味道”。经典台词“我自横眉向天笑”说得那叫一个深情，仿佛下一秒就要跳进黄河洗清白。"
        }
      },
      "questions": [
        {
          "id": 1,
          "question": "当你感到迷茫或痛苦时，你通常会怎么做？",
          "options": [
            {
              "id": "A",
              "text": "寻找归宿。 想要回到熟悉的地方，或者找一个能包容自己的人，寻求精神上的慰藉和安宁。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "自我封闭。 躲进自己的‘冰霜世界’，拒绝与外界交流，用冷漠来掩饰内心的脆弱，独自舔舐伤口。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "独自修行。 去爬山、去徒步、去冥想，通过肉体的折磨或孤独的思考来寻找答案，试图悟出人生的真谛。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 2,
          "question": "朋友向你倾诉痛苦，你作为INFJ，第一反应是？",
          "options": [
            {
              "id": "A",
              "text": "‘别怕，跟我回家。’给他一个拥抱，告诉他无论发生什么，你都会是他最后的港湾。",
