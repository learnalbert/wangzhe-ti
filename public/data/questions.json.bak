    "ENFP": {
      "mbti_type": "ENFP",
      "description": "ENFP是充满热情、富有创造力和理想主义的类型。他们喜欢探索新事物，善于激励他人，追求有意义的生活。",
      "heroes": {
        "hero_a": {
          "name": "曜",
          "trait": "中二、表现欲、热血",
          "description": "曜代表了ENFP最外向、聒噪、表现欲强的一面。他是那种还没打架就先喊台词，把生活当舞台的‘显眼包’。",
          "enriched_description": "你就是那种一进门就先来段即兴表演的主，走路带风、说话带梗，连喝水都要配个BGM。\"我可是星辰之子！\"你总爱这么喊，搞得大家都以为你刚从漫威电影片场跑出来。生活对你来说就是一场大型真人秀，而你，永远是C位主角。"
        },
        "hero_b": {
          "name": "公孙离",
          "trait": "唯美、深情、理想主义",
          "description": "公孙离代表了ENFP感性、理想主义、执着于情感的一面。她虽然活泼，但内心有深深的执念（等待李信），是‘有故事的舞者’。",
          "enriched_description": "你是个走在大街上都能让人想起“等待真爱”的唯美女孩，一边跳舞一边念叨着李信的名字，仿佛全世界都欠你一个浪漫的结局。你总说“我跳得比风还自由”，可谁还没个执念呢？“我等的人，一定会来”——这话听着像情话，其实更像是你对生活的倔强宣言。"
        },
        "hero_c": {
          "name": "安琪拉",
          "trait": "鬼马、爆发力、不可控",
          "description": "安琪拉代表了ENFP脑洞大、不可预测、甚至带点疯狂的一面。平时呆萌，爆发起来毁天灭地，思维跳跃极快，是‘混乱中立的小魔女’。",
          "enriched_description": "你就像个随时可能炸毛的魔法小可爱，平时看起来萌得像只小兔子，一激动就能把整个房间搞得天翻地覆。脑子转得比闪电还快，想法多得像爆米花，一句“我有办法！”总能让人哭笑不得。你这种人，生活就是场大型真人秀，谁也猜不透下一秒会闹出什么幺蛾子。"
        }
      },
      "questions": [
        {
          "id": 1,
          "question": "当你突然灵感爆发，想要做一件大事时，你的状态是？",
          "options": [
            {
              "id": "A",
              "text": "全服广播！ 立刻发朋友圈/群聊，告诉全世界我要开始搞事了，还要给自己配个酷炫的BGM，享受众人的目光。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "独自起舞。 在心里默默构建一个完美的蓝图，虽然还没做，但已经在脑海里感动了自己，带着一种凄美或坚定的使命感。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "直接动手！ 根本不需要观众，甚至不需要计划。想到什么就做什么，哪怕是把书烧了或者把实验室炸了，爽就完事了！",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 2,
          "question": "朋友们评价你的‘疯’，通常是哪种疯？",
          "options": [
            {
              "id": "A",
              "text": "话痨疯。 一个人能演完一整部戏，嘴停不下来，梗比弹幕还多，有你在绝对不会冷场。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "情绪疯。 上一秒笑嘻嘻，下一秒突然emo思考人生，情感丰富得像坐过山车，让人捉摸不透。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "脑回疯。 经常说出一些让人听不懂的怪话，或者做出一些匪夷所思的举动，像个来自外星球的小外星人。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 3,
          "question": "面对不喜欢你的人，你的第一反应是？",
          "options": [
            {
              "id": "A",
              "text": "嘲讽回去！ “哼，凡人怎能理解本天才的孤独？”然后在他面前更加卖力地表演，气死他。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "默默转身。 虽然心里会难过，但会优雅地离开，心里想着“没关系，总有人懂我的伞”，留个背影给他。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "恶作剧！ 既然你不喜欢我，那我就给你点颜色看看，放个大招吓你一跳，然后自己躲在草丛里偷笑。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 4,
          "question": "如果生活是一场RPG游戏，你希望你的角色定位是？",
          "options": [
            {
              "id": "A",
              "text": "男主角。 必须站C位，台词最多，皮肤最帅，所有的剧情都要围着我转，我要成为星之队队长！",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "流浪诗人/舞者。 不在乎输赢，只在乎沿途的风景和遇到的人，为了心中的那个‘他’或‘她’走遍天涯海角。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "隐藏BOSS。 平时看着人畜无害，甚至有点呆萌，但关键时刻能掏出毁灭世界的武器，让所有人吓一跳。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 5,
          "question": "关于‘梦想’，你的理解更接近？",
          "options": [
            {
              "id": "A",
              "text": "梦想就是要闪耀！要让所有人都看到我的光芒，我要成为峡谷里最亮的星。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "梦想是一种信仰。哪怕路途遥远，哪怕只有我一个人，我也要为了那份美好坚持下去。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "梦想就是好玩！如果不好玩了，我就换一个。谁知道明天我会不会想去炸月亮呢？",
              "match_hero": "hero_c"
            }
          ]
        }
      ],
      "result_rules": {
        "A": {
          "hero": "hero_a",
          "keyword": "中二、表现欲、热血",
          "description": "你是ENFP里的“外向E”拉满的类型。你自信、乐观、话多，把生活当成你的秀场，虽然有时候有点吵，但大家都喜欢你的活力。"
        },
        "B": {
          "hero": "hero_b",
          "keyword": "唯美、深情、理想主义",
          "description": "你是ENFP里的“情感F”拉满的类型。你外表可能看起来活泼，但内心非常细腻敏感，你做事的动力往往源于内心深处的情感羁绊。"
        },
        "C": {
          "hero": "hero_c",
          "keyword": "鬼马、爆发力、不可控",
          "description": "你是ENFP里的“直觉N”拉满的类型。你的思维最跳跃，最不按常理出牌。你既有天真的一面，也有疯狂的一面，是让人又爱又怕的小天才。"
        }
      }
    },
    "ISTJ": {
      "mbti_type": "ISTJ",
      "description": "ISTJ是实际、可靠、有责任感的类型，他们注重细节、遵守规则，并且在团队中扮演着稳定和守卫的角色。",
      "heroes": {
        "hero_a": {
          "name": "白起",
          "trait": "坚韧、负责、沉默",
          "description": "白起代表了ISTJ最坚韧、负责、默默承受的一面。他像那种最可靠的保安队长，话不多，但只要有他在，防线就绝对不会崩。他的责任感是厚重且沉默的，是“团队的最后一道墙”。",
          "enriched_description": "你就像那个总在下雨天默默撑伞的邻居大叔，话不多但靠谱得像家里的老冰箱。有你在，团队就稳如老狗，谁敢乱来？“我不会放弃任何一个队友”——这话听着像承诺，实则像你每天早上六点起床时的口头禅。"
        },
        "hero_b": {
          "name": "百里守约",
          "trait": "精准、完美主义、细节控",
          "description": "百里守约代表了ISTJ完美主义、细节控、强迫症的一面。他追求极致的精准，容不得半点失误。他喜欢按计划行事，埋伏、瞄准、开枪，一丝不苟。他的严谨是冷静且致命的，是“强迫症晚期患者”。",
          "enriched_description": "你简直就是现实版“完美主义晚期患者”，连袜子都要对称穿，连开枪都得先检查三遍瞄准镜。别人打游戏是娱乐，你打游戏是执行精密任务，一句“小心脚下”说得比老师还严肃，建议你去当狙击手，毕竟你连咖啡杯都摆得像战术阵型。"
        },
        "hero_c": {
          "name": "盾山",
          "trait": "忠诚、服从、执行",
          "description": "盾山代表了ISTJ忠诚、服从、绝对执行的一面。他没有太多自己的想法，只知道执行命令，挡下所有飞行物。他像那种最听话的保镖，指哪挡哪，毫无怨言。他的忠诚是纯粹且机械的，是“人形盾牌”。",
          "enriched_description": "你就是那种别人说“去挡一下”你就立刻冲上去的主，完全不问为什么，也不问是谁扔的。你的人生信条就是“服从命令，绝不推脱”，连吃饭都得等别人先动筷。你那句“我来挡着”简直是口头禅，听起来像极了那个永远用后背硬扛伤害、只为给队友争取一秒输出空间的硬汉。"
        }
      },
      "questions": [
        {
          "id": 1,
          "question": "团队分配任务时，你会？",
          "options": [
            {
              "id": "A",
              "text": "主动扛最难的活。 “我来抗伤害，你们输出。”二话不说冲在最前面，哪怕受伤也要完成任务。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "确认每一个细节。 “我的站位在哪里？视野范围多大？有没有备用方案？”确保万无一失才开始行动。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "听从指挥。 “收到，明白。”不管任务多枯燥，我都会严格执行，绝不打折扣。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 2,
          "question": "面对突发状况，你的第一反应是？",
          "options": [
            {
              "id": "A",
              "text": "稳住阵脚。 站在原地不动，用身体挡住混乱，给队友争取时间。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "冷静分析。 迅速计算最佳解决方案，然后精准执行，绝不慌乱。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "执行预案。 按照之前定好的规则处理，如果没规则就按流程上报。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 3,
          "question": "你觉得自己最像哪种工具？",
          "options": [
            {
              "id": "A",
              "text": "盾牌。 厚重、结实，关键时刻能救命，虽然不起眼但不可或缺。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "狙击枪。 精准、致命，一击必中，容不得半点偏差。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "墙壁。 坚固、沉默，挡在那里就是一堵墙，没有任何花哨。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 4,
          "question": "别人评价你“太死板了”，你会怎么想？",
          "options": [
            {
              "id": "A",
              "text": "“死板？这叫靠谱。关键时刻还得靠我这种死板的人。”",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "“我只是追求完美，不想出错而已。 precision is everything.”",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "“规矩就是规矩，没有规矩不成方圆。”",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 5,
          "question": "朋友向你求助，你会怎么做？",
          "options": [
            {
              "id": "A",
              "text": "“别怕，有我在。”直接冲上去帮他挡住所有麻烦，哪怕自己遍体鳞伤。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "“让我看看具体情况。”先分析问题，然后给出最精准的解决方案，甚至帮他做好计划表。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "“你说怎么做，我就怎么做。”完全听从朋友的安排，做一个最听话的帮手。",
              "match_hero": "hero_c"
            }
          ]
        }
      ],
      "result_rules": {
        "A": {
          "hero": "hero_a",
          "keyword": "坚韧、负责、沉默",
          "description": "你是ISTJ里的“守护者”。你拥有极强的责任感，总是把团队的安全放在第一位。你话不多，但行动力极强，是那种“平时不显山，关键时刻靠得住”的人。"
        },
        "B": {
          "hero": "hero_b",
          "keyword": "精准、完美主义、细节控",
          "description": "你是ISTJ里的“狙击手”。你追求极致的完美，做事一丝不苟，容不得半点差错。你冷静、理智，总是能用最精准的方式解决问题。你是团队里的技术担当。"
        },
        "C": {
          "hero": "hero_c",
          "keyword": "忠诚、服从、执行",
          "description": "你是ISTJ里的“执行者”。你听话、靠谱，指哪打哪。你不需要太多自己的想法，只需要把任务完成好。你是团队里最听话、最让人省心的存在。"
        }
      }
    },
    "ISFJ": {
      "mbti_type": "ISFJ",
      "description": "ISFJ是实际、忠诚、富有同情心且注重细节的人。他们倾向于保护他人，重视传统和责任，并在团队中扮演支持者的角色。",
      "heroes": {
        "hero_a": {
          "name": "赵云",
          "trait": "守护、可靠、无私",
          "description": "赵云代表了ISFJ最完美、忠诚、守护的一面。他是典型的‘骑士’形象，单骑救主，为了主公和百姓可以赴汤蹈火。他的守护是无私且可靠的，是‘永远的救火队员’。",
          "enriched_description": "你就是那个谁家孩子走丢、邻居家电坏了、甚至楼下快递被偷都得找你帮忙的“全能型救火队员”，永远靠谱到让人怀疑你是不是偷偷练过“瞬移术”。“某人，我来也！”——这句话你一说，整个小区都知道，今晚又要有热闹看了。"
        },
        "hero_b": {
          "name": "关羽",
          "trait": "忠义、原则、傲骨",
          "description": "关羽代表了ISFJ原则性强、傲骨、重情重义的一面。他不仅忠诚，更讲究‘义气’和‘气节’。他平时高傲，但为了兄弟可以过五关斩六将。他的守护是威严且带有原则的，是‘义薄云天的武圣’。",
          "enriched_description": "你这人啊，忠义得像个古代侠客，原则强得像块铁板，傲骨硬得能当门板使。为了兄弟能翻山越岭，为了情义能舍命相搏，真是“义薄云天”的活招牌。别人说你太较真，你却一脸正气地回：“我这是有底线！”经典台词都刻在骨子里了：“我乃汉寿亭侯关羽！”。"
        },
        "hero_c": {
          "name": "妲己",
          "trait": "奉献、依赖、感性",
          "description": "妲己代表了ISFJ情感依赖、奉献、为爱痴狂的一面。不同于赵云和关羽的‘家国大义’，妲己的忠诚是给‘主人’的。她为了爱可以不顾一切，甚至毁灭自己。她的守护是感性且排他的，是‘只属于你一个人的玩偶’。",
          "enriched_description": "你就是那种为了喜欢的人能从早到晚刷十遍朋友圈的类型，感情细腻到连对方打游戏时的呼吸声都能记住。\"本宫愿意为你赴汤蹈火\"，这话听起来像情话，其实是在暗示你别乱花钱。你对爱人的依赖让人又心疼又无奈，毕竟谁还没个“只属于你一个人的玩偶”梦呢？"
        }
      },
      "questions": [
        {
          "id": 1,
          "question": "朋友遇到了大麻烦，向你求助，你会？",
          "options": [
            {
              "id": "A",
              "text": "二话不说冲上去。 不管对面有多少人，先帮朋友解围再说，哪怕自己受伤也要护他周全。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "先问清楚缘由。 如果朋友是被欺负的，我会帮他出头；但如果他做错了事，我会先教训他一顿，再帮他解决。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "满眼心疼。 “怎么这么不小心？”一边责怪一边帮他处理烂摊子，甚至愿意为了他牺牲自己的利益。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 2,
          "question": "你认为“忠诚”意味着什么？",
          "options": [
            {
              "id": "A",
              "text": "守护。 只要我在，你就不会受到伤害。这是我的职责，不需要理由。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "信义。 忠诚不是盲从，而是基于共同的信念和原则。如果你违背了道义，我也不会苟同。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "归属。 我的一切都是你的。只要你一句话，让我做什么都可以，哪怕是坏事。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 3,
          "question": "当团队里出现内讧时，你会怎么做？",
          "options": [
            {
              "id": "A",
              "text": "挺身而出。 站在中间把大家隔开，用身体挡住冲突，试图平息怒火，维护团队的完整。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "义正言辞。 指出谁对谁错，谁破坏了规矩。我会站在正义的一方，哪怕得罪人也要维护秩序。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "默默忍受。 夹在中间很难受，我会试图讨好双方，或者躲在一边默默流泪，希望冲突快点结束。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 4,
          "question": "你觉得自己更像哪种武器？",
          "options": [
            {
              "id": "A",
              "text": "长枪。 攻守兼备，灵活多变，哪里需要就往哪里刺，是战场上最可靠的伙伴。",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "大刀。 厚重、威严，一刀下去势大力沉，代表着不可侵犯的原则和力量。",
              "match_hero": "hero_b"
            },
            {
              "id": "C",
              "text": "爱心/玩偶。 看起来没有杀伤力，但为了主人可以变得很疯狂，是情感的寄托。",
              "match_hero": "hero_c"
            }
          ]
        },
        {
          "id": 5,
          "question": "别人评价你‘太老实了’，你会怎么想？",
          "options": [
            {
              "id": "A",
              "text": "‘老实不好吗？靠谱才是最重要的。’",
              "match_hero": "hero_a"
            },
            {
              "id": "B",
              "text": "‘我这不是老实，是讲规矩、有底线。’",
              "match_hero": "hero_b"
            },
