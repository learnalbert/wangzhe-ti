    "ENTJ": {
      "mbti_type": "ENTJ",
      "description": "ENTJ是天生的领导者，他们充满自信、果断且富有战略眼光。他们擅长制定计划并推动执行，追求效率和成果。ENTJ通常具有强烈的领导欲望，喜欢掌控局面，并通过逻辑和理性来解决问题。",
      "heroes": {
        "hero_a": {
          "name": "米莱狄",
          "trait": "效率、系统、冷血理性",
          "description": "代表了ENTJ冷峻、去人性化、信系统不信人的一面。情绪和人情都是噪音，只有结果和最优解才作数。",
          "enriched_description": "你是那种习惯把事情拆成流程、把人拆成角色的人。别人觉得你冷，其实你只是不愿意把判断交给情绪——你更相信制度、数据和规则，因为它们不会临时变卦。能用系统解决的事，你绝不靠人情去兜。"
        },
        "hero_b": {
          "name": "司空震",
          "trait": "法度、正义、雷霆手段",
          "description": "代表了ENTJ有道义底线、为对的事亲自出手的一面。掌控欲不是为了赢，而是为了让该对的事真的对。",
          "enriched_description": "你是那种看到不公就坐不住的人。别人还在权衡利弊、计算代价，你已经站出来了——因为你心里那条线很清楚，越过去就是不行。你对自己狠，对原则更狠，宁可自己扛事，也不愿意看着错的事就这么过去。"
        }
      },
