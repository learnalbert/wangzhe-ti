  "heroQuizzes": {
    "INTJ": {
      "mbti_type": "INTJ",
      "description": "INTJ是内向、直觉、思考、判断型人格，通常被称为战略家。他们理性、独立、有远见，擅长规划和分析，追求效率和知识，不喜欢琐碎的社交活动。",
      "heroes": {
        "hero_a": {
          "name": "司马懿",
          "trait": "隐忍、务实、长线思维",
          "description": "代表了INTJ沉得住气、看得长远、能屈能伸的一面。眼下的得失不重要，重要的是最后谁还站着。",
          "enriched_description": "你是那种话不多、但心里一本账算得门儿清的人。眼前的争吵、面子、虚名，对你来说都不太重要——你更在意几年后自己手里能握住什么。别人觉得你低调甚至有点闷，其实你只是把劲儿都留在了关键时刻。"
        },
        "hero_b": {
          "name": "诸葛亮",
          "trait": "理想、自律、责任驱动",
          "description": "代表了INTJ心中有道、自我严格、为信念燃烧的一面。一旦认定一件事，就会扛到底，哪怕透支自己。",
          "enriched_description": "你是那种心里总装着一件比自己更大的事的人。答应过的、相信过的，就会一直放在心上，不会轻易松手。你对自己很严，对身边人也有要求——但那是因为你真的把这件事当成自己的事在做。"
        }
      },
      "questions": [
