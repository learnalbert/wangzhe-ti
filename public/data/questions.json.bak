      "result_rules": {
        "A": {
          "hero": "hero_a",
          "keyword": "隐忍、务实、长线思维",
          "description": "你是INTJ里的\"长线玩家\"。你不在乎眼前的得失，只在乎最后谁还站着。你能屈能伸、沉得住气，把眼下的隐忍变成将来的底牌。"
        },
        "B": {
          "hero": "hero_b",
          "keyword": "理想、自律、责任驱动",
          "description": "你是INTJ里的\"理想主义者\"。你心里总装着一件比自己更大的事，一旦认定就会扛到底。你对自己严，对承诺更严，是那种愿意为信念燃烧的人。"
        }
      }
    },
    "INTP": {
      "mbti_type": "INTP",
      "description": "INTP是理性、独立、逻辑性强的类型，擅长分析和解决问题。他们喜欢探索抽象概念，追求知识和理解，通常表现出冷静、内向和批判性思维。",
      "heroes": {
        "hero_a": {
          "name": "鲁班大师",
          "trait": "动手、改造、实用导向",
          "description": "代表了INTP爱折腾、动手能力强、想法必须落地的一面。光在脑子里想不算数，做出来、用上了才算想清楚。",
          "enriched_description": "你是那种脑子里一冒出想法就想立刻动手验证的人。看到不顺手的东西会忍不住改造，做出来还会兴致勃勃地拿给身边人看。比起空谈，你更相信\"做出来摆这儿\"才有说服力。"
        },
        "hero_b": {
          "name": "元歌",
          "trait": "沉浸、内敛、借物代言",
          "description": "代表了INTP安静、自我沉浸、用作品代替自己出面的一面。不喜欢被围观、不爱解释，更愿意让做出来的东西替自己说话。",
          "enriched_description": "你是那种一个人安静琢磨事情时最舒服的人。比起亲自开口讲，你更愿意把心思放进作品里，让它们替你表达。被围观、被评价会让你不自在——你享受的是沉浸在自己世界里的那种专注感。"
        }
      },
