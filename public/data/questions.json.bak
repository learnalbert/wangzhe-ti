    "ENFJ": {
      "mbti_type": "ENFJ",
      "description": "ENFJ是充满同理心和领导力的类型，他们善于激励他人、关注他人的感受，并具有强烈的使命感。ENFJ通常被视为理想主义者，他们希望创造一个更美好的世界，并通过自己的影响力来实现这一目标。",
      "heroes": {
        "hero_a": {
          "name": "刘备",
          "trait": "仁德、深沉、大家长",
          "description": "刘备代表ENFJ的深沉与责任感，他是团队中的精神领袖，注重情感连接与长远愿景，愿意为团队牺牲自己。",
          "enriched_description": "你这刘备啊，简直就是现实版“老好人”，天天想着团队好，自己却总是最后一个吃饱。别人打架你劝架，别人吵架你调解，活像个大型家庭的大家长。别看平时挺沉稳，一开口就是“兄弟们，咱们一起冲！”这台词真·正能量爆棚，听得人心里暖洋洋的，恨不得立刻给你端碗面！"
        },
        "hero_b": {
          "name": "孙策",
          "trait": "热血、行动、少年气",
          "description": "孙策代表ENFJ的激情与果断，他充满活力，敢于冒险，是推动团队前进的先锋力量。",
          "enriched_description": "你要是遇到孙策这种人，准保被他的热血感染得想立刻冲出去闯荡江湖！他做事从不拖泥带水，一句“我先上啦”就能让你瞬间热血沸腾。生活中他就像个永远充满能量的少年，啥事都敢干、啥事都敢想，简直就是行走的“莽夫正能量”！“我先上啦！”——这句话一出，谁还忍得住不跟着你疯？"
        },
        "hero_c": {
          "name": "朵莉亚",
          "trait": "治愈、陪伴、小太阳",
          "description": "朵莉亚代表ENFJ的关怀与支持，她温暖而富有同理心，是团队中不可或缺的情感纽带。",
          "enriched_description": "你就像个自带暖宝宝功能的贴心小太阳，走到哪暖到哪，队友缺氧都能被你哄好。别人吵架你负责劝和，有人难过你负责安慰，简直是现实版“情绪稳定器”。“别怕，我在这呢。”你总这么说，结果人家真就真的不怕了。"
        }
      },
